repositories:
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx

environments:
  default:
    values:
      - environments/default/values.yaml.gotmpl

---

releases:
  - name: ingress-nginx
    namespace: {{ .Values.namespace }}
    chart: ingress-nginx/ingress-nginx
    version: 4.12.1
    wait: true
    values:
      - values/ingress-nginx.yaml.gotmpl

  - name: diploma-orchestrator-minio
    namespace: {{ .Values.namespace }}
    chart: bitnami/minio
    version: 14.8.5
    wait: true
    values:
      - values/minio.yaml.gotmpl

  - name: diploma-orchestrator-postgresql
    namespace: {{ .Values.namespace }}
    chart: bitnami/postgresql
    version: 12.2.7
    wait: true
    values:
      - values/postgresql.yaml.gotmpl

  - name: diploma-orchestrator-api
    namespace: {{ .Values.namespace }}
    chart: ./charts/orchestrator-api
    needs:
      - {{ .Values.namespace }}/ingress-nginx
      - {{ .Values.namespace }}/diploma-orchestrator-postgresql
    values:
      - values/api.yaml.gotmpl

  - name: diploma-orchestrator-ui
    namespace: {{ .Values.namespace }}
    chart: ./charts/orchestrator-ui
    needs:
      - {{ .Values.namespace }}/ingress-nginx
    values:
      - values/ui.yaml.gotmpl
