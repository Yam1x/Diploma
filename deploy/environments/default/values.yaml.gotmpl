namespace: {{ if eq .Environment.Name "default" }}local{{ else }}{{ .Environment.Name }}{{ end }}

postgresql:
  auth:
    postgresPassword: postgres
    database: orchestrator
  service:
    host: diploma-orchestrator-postgresql
    port: 5432

minio:
  auth:
    rootUser: admin
    rootPassword: minio123456
  service:
    host: diploma-orchestrator-minio
    port: 9000
  defaultBuckets: backups
  region: us-east-1

ingress:
  host: localhost
