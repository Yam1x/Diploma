namespace: {{ env "ORCHESTRATOR_NAMESPACE" | default "diploma-system" }}

postgresql:
  auth:
    postgresPassword: postgres
    database: orchestrator
  service:
    host: postgresql
    port: 5432

backupImage:
  registry: ghcr.io
  repository: yam1x/diploma-db-backupper
  tag: latest
  pullPolicy: Always

backupChart:
  repositoryUrl: https://github.com/Yam1x/Diploma.git
  ref: master
  path: diploma-db-backupper/ci

minio:
  auth:
    rootPassword: minio123456
  defaultBuckets: backups
  apiHost: minio-s3
  consoleHost: minio-s3-console

ingress:
  host: localhost
  externalPort: 40110
