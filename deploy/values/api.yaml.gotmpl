replicaCount: 1

image:
  repository: {{ .Values.apiImageRepository }}
  tag: {{ .Values.apiImageTag }}
  pullPolicy: {{ .Values.apiImagePullPolicy }}

service:
  port: {{ .Values.apiPort }}

config:
  databaseUrl: {{ printf "postgresql+psycopg://postgres:%s@%s:%v/%s" .StateValues.postgresql.auth.postgresPassword .StateValues.postgresql.service.host .StateValues.postgresql.service.port .StateValues.postgresql.auth.database | quote }}
  backupImage:
    registry: {{ .Values.backupImage.registry | quote }}
    repository: {{ .Values.backupImage.repository | quote }}
    tag: {{ .Values.backupImage.tag | quote }}
    pullPolicy: {{ .Values.backupImage.pullPolicy | quote }}

secret:
  kubeconfig: |
{{ .Values.kubeconfig | indent 4 }}
